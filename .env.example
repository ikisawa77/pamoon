# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# ใช้ MariaDB/MySQL เช่น mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://root@127.0.0.1:3306/pamoon"

# Auth
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Internal jobs / cron
# ใช้กับ /api/internal/cards/sync, /api/internal/sla/run และ /api/internal/email/flush
INTERNAL_JOB_TOKEN=

# Mock OTP for seller application on localhost/dev
OTP_PROVIDER=mock
OTP_DEV_CODE_VISIBLE=true
OTP_EXPIRES_MINUTES=10

# Email notifications
# ตั้งค่า SMTP จริงเพื่อส่งอีเมลจาก outbox; ถ้าไม่ตั้ง ระบบจะ mark เป็น SKIPPED เมื่อกด flush
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Pamoon <no-reply@pamoon.local>"

# Payments / wallet top-up provider (planned)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Card master import source
DATA_CARDGAME_SOURCE_URL=https://data-cardgame.com/prices_full.json
