generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  MEMBER
  SHOP
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_REVIEW
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingMode {
  AUCTION
  BUY
}

enum ProductCategory {
  OP01
  OP02
  OP03
  OP04
  OP05
}

enum ProductRarity {
  C
  UC
  R
  L
  SR
  SEC
  SP
  P
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  ENDED
  REMOVED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  CANCELLED
}

enum WalletTransactionType {
  TOP_UP
  BID_HOLD
  BID_RELEASE
  PURCHASE
  SELLER_PAYOUT
  REFUND
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  DISPUTED
  PAYMENT_EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum OrderSource {
  BUY_NOW
  AUCTION
}

enum NotificationType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  BID_PLACED
  BID_OUTBID
  BID_WINNING
  AUCTION_WON
  PAYMENT_DUE
  PAYMENT_OVERDUE
  SHIPPING_DUE
  SHIPPING_EXTENDED
  SHIPPING_OVERDUE
  REFUND_CREATED
  ACCOUNT_SUSPENDED
  CHAT_MESSAGE
  SHOP_MESSAGE
  SYSTEM
}

enum ChatThreadStatus {
  ACTIVE
  ARCHIVED
}

enum ModerationCaseType {
  BUYER_PAYMENT_OVERDUE
  SELLER_SHIPPING_OVERDUE
}

enum ModerationCaseStatus {
  OPEN
  RESOLVED
}

enum HomeContentType {
  SLIDE
  PROMOTION
  ARTICLE
  FEATURED_SHOP
}

enum EmailNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique @db.VarChar(191)
  displayName        String              @db.VarChar(120)
  passwordHash       String?             @db.VarChar(255)
  role               UserRole            @default(MEMBER)
  status             AccountStatus       @default(ACTIVE)
  walletBalanceCents Int                 @default(0)
  bidLimitCents      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  shops              Shop[]
  bids               Bid[]
  walletTransactions WalletTransaction[]
  orders             Order[]
  notifications      Notification[]      @relation("NotificationRecipient")
  sentNotifications  Notification[]      @relation("NotificationActor")
  buyerChatThreads   ChatThread[]        @relation("ChatBuyer")
  chatMessages       ChatMessage[]
  moderationCases    ModerationCase[]    @relation("ModerationUser")
  assignedCases      ModerationCase[]    @relation("ModerationAssignee")
  favoriteProducts   FavoriteProduct[]
  emailNotifications EmailNotification[]

  @@index([role])
  @@index([status])
}

model Shop {
  id          String     @id @default(cuid())
  ownerId     String
  name        String     @unique @db.VarChar(120)
  slug        String     @unique @db.VarChar(120)
  status      ShopStatus @default(PENDING)
  rating      Float      @default(0)
  reviewCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]
  chatThreads ChatThread[]
  moderationCases ModerationCase[]

  @@index([ownerId])
  @@index([status])
}

model Product {
  id                 String          @id @default(cuid())
  sellerShopId       String
  title              String          @db.VarChar(160)
  cardCode           String          @db.VarChar(80)
  setCode            String          @db.VarChar(40)
  setName            String          @db.VarChar(120)
  category           ProductCategory
  rarity             ProductRarity
  mode               ListingMode
  status             ProductStatus   @default(ACTIVE)
  conditionLabel     String          @db.VarChar(60)
  description        String?         @db.Text
  imageUrl           String?         @db.VarChar(255)
  openingPriceCents  Int
  currentPriceCents  Int
  nextBidCents       Int
  buyNowPriceCents   Int?
  watcherCount       Int             @default(0)
  auctionEndsAt      DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sellerShop         Shop            @relation(fields: [sellerShopId], references: [id], onDelete: Cascade)
  bids               Bid[]
  order              Order?
  notifications      Notification[]
  chatThreads        ChatThread[]
  favorites          FavoriteProduct[]

  @@index([sellerShopId])
  @@index([mode, status])
  @@index([category])
  @@index([rarity])
  @@index([auctionEndsAt])
}

model Bid {
  id          String    @id @default(cuid())
  productId   String
  bidderId    String
  amountCents Int
  status      BidStatus @default(ACTIVE)
  outbidNotifiedAt DateTime?
  endingSoonNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bidder      User      @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([productId])
  @@index([bidderId])
  @@index([status])
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  userId        String
  type          WalletTransactionType
  status        WalletTransactionStatus @default(PENDING)
  amountCents   Int
  referenceType String?                 @db.VarChar(60)
  referenceId   String?                 @db.VarChar(191)
  note          String?                 @db.VarChar(255)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type, status])
  @@index([referenceType, referenceId])
}

model Order {
  id                 String      @id @default(cuid())
  productId          String      @unique
  buyerId            String
  sellerShopId       String
  amountCents        Int
  platformFeeCents   Int         @default(0)
  status             OrderStatus @default(PENDING_PAYMENT)
  shippingName       String?     @db.VarChar(120)
  shippingAddress    String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer              User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  sellerShop         Shop        @relation(fields: [sellerShopId], references: [id], onDelete: Restrict)
  notifications      Notification[]
  chatThread         ChatThread?
  moderationCases    ModerationCase[]
  source             OrderSource @default(BUY_NOW)
  paymentDueAt       DateTime?
  paidAt             DateTime?
  shipDueAt          DateTime?
  shippedAt          DateTime?
  shippingExtendedAt DateTime?
  shippingExtensionCount Int     @default(0)
  refundDueAt        DateTime?
  refundedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  trackingNumber     String?     @db.VarChar(120)

  @@index([buyerId])
  @@index([sellerShopId])
  @@index([status])
  @@index([paymentDueAt])
  @@index([shipDueAt])
  @@index([refundDueAt])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String           @db.VarChar(160)
  message     String           @db.VarChar(500)
  href        String?          @db.VarChar(255)
  productId   String?
  orderId     String?
  bidId       String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bid         Bid?             @relation(fields: [bidId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
  @@index([type])
  @@index([productId])
  @@index([orderId])
  @@index([bidId])
}

model ChatThread {
  id            String           @id @default(cuid())
  orderId       String           @unique
  buyerId       String
  sellerShopId  String
  productId     String
  status        ChatThreadStatus @default(ACTIVE)
  lastMessageAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer         User             @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerShop    Shop             @relation(fields: [sellerShopId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([buyerId, status])
  @@index([sellerShopId, status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  body      String     @db.VarChar(1000)
  readAt    DateTime?
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model ModerationCase {
  id           String               @id @default(cuid())
  type         ModerationCaseType
  status       ModerationCaseStatus @default(OPEN)
  userId       String?
  shopId       String?
  orderId      String?
  assignedToId String?
  reason       String               @db.VarChar(500)
  createdAt    DateTime             @default(now())
  resolvedAt   DateTime?
  user         User?                @relation("ModerationUser", fields: [userId], references: [id], onDelete: SetNull)
  shop         Shop?                @relation(fields: [shopId], references: [id], onDelete: SetNull)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("ModerationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([userId])
  @@index([shopId])
  @@index([orderId])
}

model HomeContent {
  id          String          @id @default(cuid())
  type        HomeContentType
  title       String          @db.VarChar(160)
  subtitle    String?         @db.VarChar(255)
  body        String?         @db.Text
  href        String?         @db.VarChar(255)
  imageUrl    String?         @db.VarChar(255)
  badge       String?         @db.VarChar(80)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive, sortOrder])
}

model FavoriteProduct {
  id                    String    @id @default(cuid())
  userId                String
  productId             String
  emailNotify           Boolean   @default(true)
  notifyOutbid          Boolean   @default(true)
  notifyEndingSoon      Boolean   @default(true)
  endingSoonNotifiedAt  DateTime?
  disabledAfterAuctionAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, emailNotify])
  @@index([userId, createdAt])
}

model EmailNotification {
  id          String                  @id @default(cuid())
  recipientId String
  toEmail     String                  @db.VarChar(191)
  subject     String                  @db.VarChar(180)
  body        String                  @db.Text
  status      EmailNotificationStatus @default(PENDING)
  reason      String?                 @db.VarChar(255)
  sentAt      DateTime?
  createdAt   DateTime                @default(now())
  recipient   User                    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([status, createdAt])
}
